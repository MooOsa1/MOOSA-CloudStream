# Required for the REAL TMDB catalog. Use either a v3 API key or a v4 read token.
TMDB_API_KEY=
# TMDB_READ_ACCESS_TOKEN=
PORT=3000
# Optional: path to an authorized stream manifest, relative to MOOSAWeb/
# STREAMS_FILE=data/streams.json

# OPTIONAL remote Android-compatible CloudStream engine (NOT included in Node hosting).
# Only configure after deploying and securing an engine under your control.
# CLOUDSTREAM_RUNTIME_URL=https://your-engine-host.example
# CLOUDSTREAM_RUNTIME_TOKEN=use-a-long-random-private-secret
# Do NOT share runtime token with frontend or commit to GitHub.
