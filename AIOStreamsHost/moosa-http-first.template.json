{
  "metadata": {
    "id": "moosa.http-first",
    "name": "MOOSA Hub — HTTP First, Torrent Last",
    "description": "Prioritize direct HTTPS playable media and 4K / 1080p / 720p. Preserve torrent (P2P) sources only as the last resort; Safari cannot play magnet/P2P links without a compatible intermediary. This template contains no movie sources.",
    "source": "external",
    "author": "MOOSA",
    "version": "1.0.0",
    "category": "Browser",
    "serviceRequired": false,
    "services": []
  },
  "config": {
    "presets": [],
    "formatter": {
      "id": "prism",
      "definition": {
        "name": "",
        "description": ""
      }
    },
    "preferredQualities": [
      "BluRay REMUX",
      "BluRay",
      "WEB-DL",
      "WEBRip",
      "HDRip",
      "HC HD-Rip",
      "DVD REMUX",
      "DVDRip",
      "HDTV",
      "CAM",
      "TS",
      "TC",
      "SCR",
      "Unknown"
    ],
    "preferredResolutions": [
      "2160p",
      "1080p",
      "720p"
    ],
    "excludedQualities": [
      "CAM",
      "SCR",
      "TS",
      "TC"
    ],
    "excludedVisualTags": [
      "3D"
    ],
    "sortCriteria": {
      "global": [
        {
          "key": "streamType",
          "direction": "desc"
        },
        {
          "key": "cached",
          "direction": "desc"
        },
        {
          "key": "resolution",
          "direction": "desc"
        },
        {
          "key": "library",
          "direction": "desc"
        },
        {
          "key": "regexPatterns",
          "direction": "desc"
        },
        {
          "key": "visualTag",
          "direction": "desc"
        },
        {
          "key": "audioTag",
          "direction": "desc"
        },
        {
          "key": "audioChannel",
          "direction": "desc"
        },
        {
          "key": "encode",
          "direction": "desc"
        },
        {
          "key": "language",
          "direction": "desc"
        },
        {
          "key": "size",
          "direction": "desc"
        }
      ]
    },
    "deduplicator": {
      "enabled": true,
      "multiGroupBehaviour": "aggressive",
      "keys": [
        "filename",
        "infoHash"
      ],
      "cached": "single_result",
      "uncached": "per_service",
      "p2p": "single_result"
    },
    "excludedResolutions": [
      "576p",
      "480p",
      "360p",
      "240p",
      "144p",
      "Unknown"
    ],
    "includedResolutions": [],
    "requiredResolutions": [
      "2160p",
      "1080p",
      "720p"
    ],
    "includedQualities": [],
    "requiredQualities": [],
    "excludedLanguages": [],
    "includedLanguages": [],
    "requiredLanguages": [],
    "preferredLanguages": [],
    "includedVisualTags": [],
    "requiredVisualTags": [],
    "preferredVisualTags": [],
    "excludedAudioTags": [],
    "includedAudioTags": [],
    "requiredAudioTags": [],
    "preferredAudioTags": [],
    "excludedStreamTypes": [],
    "includedStreamTypes": [],
    "requiredStreamTypes": [],
    "preferredStreamTypes": [
      "http",
      "debrid",
      "live",
      "archive",
      "external",
      "youtube",
      "usenet",
      "stremio-usenet",
      "p2p"
    ],
    "excludedEncodes": [],
    "includedEncodes": [],
    "requiredEncodes": [],
    "preferredEncodes": [],
    "seederRangeTypes": [],
    "digitalReleaseFilter": {
      "enabled": true,
      "tolerance": 0,
      "requestTypes": [],
      "addons": []
    },
    "excludeCachedFromAddons": [],
    "excludeCachedFromServices": [],
    "excludeCachedFromStreamTypes": [],
    "excludeUncachedFromAddons": [],
    "excludeUncachedFromServices": [],
    "excludeUncachedFromStreamTypes": [],
    "proxy": {
      "proxiedAddons": [],
      "proxiedServices": [],
      "id": "builtin"
    },
    "hideErrorsForResources": [],
    "statistics": {
      "statsToShow": [
        "addon",
        "filter"
      ]
    },
    "tmdbApiKey": "<template_placeholder>",
    "yearMatching": {
      "enabled": true,
      "requestTypes": [],
      "addons": []
    },
    "titleMatching": {
      "similarityThreshold": 1,
      "enabled": true,
      "requestTypes": [
        "movie",
        "series"
      ],
      "addons": []
    },
    "seasonEpisodeMatching": {
      "enabled": true,
      "requestTypes": [
        "movie",
        "series"
      ],
      "addons": []
    },
    "autoPlay": {
      "attributes": [
        "service",
        "proxied",
        "resolution",
        "quality",
        "encode",
        "audioTags",
        "visualTags",
        "languages",
        "releaseGroup"
      ]
    },
    "catalogModifications": [],
    "cacheAndPlay": {
      "enabled": false,
      "streamTypes": []
    },
    "excludedStreamExpressions": [
      "queryType == 'anime.series' ? resolution(streams, '2160p') : []"
    ]
  }
}
