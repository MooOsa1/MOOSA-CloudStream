{
  "metadata": {
    "id": "moosa.http-only",
    "name": "MOOSA Hub — Direct HTTP Only (HDHub pilot)",
    "description": "Experimental no-torrent HTTP-only MOOSA Hub. HDHub public addon returned distinct MKV media bytes for Sinners and F1 (2025). Playback and film identity not yet fully established. No P2P or paid services.",
    "source": "external",
    "author": "MOOSA",
    "version": "1.1.0",
    "category": "Browser",
    "serviceRequired": false,
    "services": [],
    "sourceUrl": "https://raw.githubusercontent.com/MooOsa1/MOOSA-CloudStream/experiment/moosa-http-only-20261019/AIOStreamsHost/moosa-direct-only.template.json"
  },
  "config": {
    "presets": [
      {
        "type": "custom",
        "instanceId": "mcm1",
        "enabled": true,
        "options": {
          "name": "Cinemeta",
          "manifestUrl": "https://v3-cinemeta.strem.io/manifest.json",
          "timeout": 6000,
          "resources": [
            "catalog",
            "meta"
          ],
          "mediaTypes": []
        }
      },
      {
        "type": "custom",
        "instanceId": "mos1",
        "enabled": true,
        "options": {
          "name": "OpenSubtitles v3",
          "manifestUrl": "https://opensubtitles-v3.strem.io/manifest.json",
          "timeout": 7000,
          "resources": [
            "subtitles"
          ],
          "mediaTypes": []
        }
      },
      {
        "type": "custom",
        "instanceId": "mhd1",
        "enabled": true,
        "options": {
          "name": "HdHub — real distinct HTTP streams (2025 live audit)",
          "manifestUrl": "https://hdhub.thevolecitor.qzz.io/manifest.json",
          "timeout": 15000,
          "resources": [
            "stream"
          ],
          "mediaTypes": [
            "movie",
            "series"
          ]
        }
      }
    ],
    "preferredResolutions": [
      "2160p",
      "1440p",
      "1080p",
      "720p",
      "Unknown"
    ],
    "excludedResolutions": [
      "576p",
      "480p",
      "360p",
      "240p",
      "144p"
    ],
    "excludedQualities": [
      "CAM",
      "SCR",
      "TS",
      "TC"
    ],
    "excludedVisualTags": [
      "3D"
    ],
    "sortCriteria": {
      "global": [
        {
          "key": "streamType",
          "direction": "desc"
        },
        {
          "key": "resolution",
          "direction": "desc"
        },
        {
          "key": "quality",
          "direction": "desc"
        },
        {
          "key": "size",
          "direction": "desc"
        }
      ]
    },
    "deduplicator": {
      "enabled": true,
      "multiGroupBehaviour": "aggressive",
      "keys": [
        "filename",
        "infoHash"
      ],
      "cached": "single_result",
      "uncached": "per_service",
      "p2p": "single_result"
    },
    "preferredStreamTypes": [
      "http"
    ],
    "preferredSubtitles": [
      "Arabic",
      "English"
    ],
    "excludedStreamTypes": [
      "p2p"
    ],
    "requiredStreamTypes": [
      "http"
    ]
  }
}
